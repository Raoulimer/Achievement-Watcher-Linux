{
  "private": true,
  "name": "Achievement-Watcher",
  "description": "Achievement viewer with real-time unlock notifications for Linux (legit Steam read offline from the Steam client, Proton included).",
  "version": "2.0.0",
  "main": "./electron/init.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "sri": "node ../scripts/sri.js",
    "clean": "npm prune --omit=dev",
    "postinstall": "patch-package"
  },
  "author": "Anthony Beaumont",
  "license": "LGPL-3.0-only",
  "devDependencies": {
    "electron": "44.5.1",
    "electron-context-menu": "3.6.1",
    "patch-package": "8.0.0"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "@xan105/fs": "^1.2.0",
    "@xan105/ini": "^1.0.1",
    "@xan105/log": "^1.0.2",
    "argv-split": "^2.0.1",
    "crc": "^3.8.0",
    "deepmerge": "4.2.2",
    "fast-glob": "^3.2.4",
    "find-up": "^4.1.0",
    "humanize-duration": "^3.25.1",
    "lodash.omit": "^4.5.0",
    "minimist": "^1.2.5",
    "moment": "^2.29.1",
    "normalize-path": "^3.0.0",
    "request-zero": "^0.3.2",
    "xml2js": "^0.6.2"
  },
  "config": {
    "debug": false,
    "user-agent": "Chrome/",
    "disable-gpu": false,
    "window": {
      "width": 1200,
      "height": 800,
      "minWidth": 1200,
      "minHeight": 800,
      "backgroundColor": "#1b2838",
      "frame": false,
      "icon": "resources/icon/icon.png",
      "view": "./view/app.html"
    },
    "update": {
      "github": "Raoulimer/Achievement-Watcher-Linux",
      "name": "AchievementWatcher-linux-x64.tar.gz"
    },
    "appid": "achievement-watcher"
  },
  "desktopName": "achievement-watcher.desktop",
  "overrides": {
    "xml2js": "$xml2js"
  }
}
